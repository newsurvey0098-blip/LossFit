ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://lossfit_app.PROJECT_REF:REPLACE_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET=replace-with-a-generated-secret-at-least-32-characters
DELETION_LEDGER_SECRET=replace-with-a-separate-stable-secret-at-least-32-characters
CORS_ORIGINS=https://lossfit.example.com
APP_BASE_URL=https://lossfit.example.com
# On Vercel, connect a private Blob store and set its BLOB_STORE_ID.
# For a persistent non-Vercel host, use an absolute durable directory instead.
BLOB_STORE_ID=
PRIVATE_UPLOAD_DIR=
BIND_HOST=127.0.0.1
PORT=3001
TRUSTED_PROXY_IPS=127.0.0.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
VISION_MODEL=
# Optional server-side data.gov API key for USDA Branded food search. Never expose it to the browser.
FDC_API_KEY=
EMBEDDING_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lossfit.example.com/api/v1/auth/google/callback
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
